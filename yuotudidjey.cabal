cabal-version:      3.0
name:               yuotudidjey
version:            0.1.0.0
synopsis:           YouTube DJ crawler driven only through blindly4: LLM exploration, generated exploitation
license:            NONE
build-type:         Simple

common shared
    default-language:   GHC2021
    default-extensions: OverloadedStrings DataKinds GADTs LambdaCase StrictData
    ghc-options:        -Wall
    build-depends:
        base >=4.18 && <5,
        aeson,
        async,
        bytestring,
        containers,
        directory,
        filepath,
        process,
        scientific,
        stm,
        text,
        time,
        unicode-transforms,
        Win32

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Yuo.Blindly
        Yuo.Chrome
        Yuo.Cli
        Yuo.Concurrent
        Yuo.Guard
        Yuo.Log
        Yuo.Match
        Yuo.Songs
        Yuo.Time
        Yuo.Tree
        Yuo.Types
    build-depends:
        optparse-applicative

executable yuotudidjey
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    yuotudidjey, optparse-applicative

test-suite spec
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        BlindlySpec
        GuardSpec
        LogSpec
        MatchSpec
        SongsSpec
        TimeSpec
        TreeSpec
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        yuotudidjey,
        hspec,
        QuickCheck,
        temporary
