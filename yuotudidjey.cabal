cabal-version:      3.0
name:               yuotudidjey
version:            0.1.0.0
synopsis:           YouTube DJ crawler driven only through blindly4: LLM exploration, generated exploitation
license:            NONE
build-type:         Simple
extra-source-files: lint/fp_lint.py

common shared
    default-language:   GHC2021
    default-extensions: OverloadedStrings DataKinds GADTs LambdaCase StrictData
    ghc-options:        -Wall
    build-depends:
        base >=4.18 && <5,
        aeson,
        async,
        bytestring,
        containers,
        directory,
        filepath,
        process,
        scientific,
        stm,
        text,
        time,
        unicode-transforms,
        vector,
        Win32

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Yuo.Blindly
        Yuo.Chrome
        Yuo.Cli
        Yuo.Codegen
        Yuo.Codegen.Contract
        Yuo.Codegen.Lint
        Yuo.Concurrent
        Yuo.Explore
        Yuo.Explore.Action
        Yuo.Explore.Prompt
        Yuo.Exploit
        Yuo.Guard
        Yuo.Llm
        Yuo.Log
        Yuo.Match
        Yuo.Metrics
        Yuo.Observer
        Yuo.Pause
        Yuo.Process
        Yuo.Report
        Yuo.SolutionEnv
        Yuo.Songs
        Yuo.Time
        Yuo.Tree
        Yuo.Types
    build-depends:
        file-embed,
        optparse-applicative

executable yuotudidjey
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    yuotudidjey, optparse-applicative

test-suite spec
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        ActionSpec
        BlindlySpec
        ExploreSpec
        GuardSpec
        LintSpec
        LlmSpec
        LogSpec
        MatchSpec
        MetricsSpec
        ObserverSpec
        SolutionEnvSpec
        SongsSpec
        TimeSpec
        TreeSpec
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:
        yuotudidjey,
        hspec,
        QuickCheck,
        temporary
