+                Thread.Sleep(100);
+            }
+            Thread.Sleep(300);
+            string pid = fixture.Id.ToString();
+            Check(Run(0, "apps").GetProperty("apps").EnumerateArray().Any(a => a.GetProperty("pid").GetInt32() == fixture.Id), "Fixture missing from apps");
+            var tree = Run(0, "tree", "--pid", pid, "--depth", "5");
